# Supabase (client-side) — আসল value গুলো .env.local-এ রাখো (git-এ কখনো commit হবে না)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Research webhook: NO client vars. Secret lives in Supabase secrets
# (RESEARCH_WEBHOOK_URL / RESEARCH_WEBHOOK_KEY) behind functions/research-proxy.
# কারণ: VITE_ prefix মানেই value client bundle-এ চলে যায় — secret হওয়া
# key-এর জন্য এটা অনৈয। proxy server-side secret ধরে Apps Script-এ call করে
# আর admin role server-side-এ verify করে।
#
#   supabase secrets set RESEARCH_WEBHOOK_URL=https://script.google.com/macros/s/.../exec \
#                        RESEARCH_WEBHOOK_KEY=<NEW_RANDOM_32_CHARS>
#   supabase functions deploy research-proxy
# Apps Script saveSecrets()-এ একই WEBHOOK_SECRET বসিয়ে Run → New version deploy।

# GEMINI key client-এ কখনো না (VITE_ prefix মানেই bundle-এ চলে যায়)।
# Edge Function secret হিসেবে রাখো:  supabase secrets set GEMINI_API_KEY=...


