# Supabase (client-side) — আসল value গুলো .env.local-এ রাখো (git-এ কখনো commit হবে না)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Apps Script research webhook (src/components/admin/UpdateQueueTab.tsx)
# WEBHOOK_KEY = Apps Script Script Property `WEBHOOK_SECRET` (rotate করার পরে নতুন value)
VITE_RESEARCH_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_WEBHOOK_KEY=your-rotated-webhook-secret

# GEMINI key client-এ কখনো না (VITE_ prefix মানেই bundle-এ চলে যায়)।
# Edge Function secret হিসেবে রাখো:  supabase secrets set GEMINI_API_KEY=...


